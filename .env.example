# Binance API credentials (optional for read-only tools)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Environment: live (default), testnet, or demo
BINANCE_TESTNET=false
# BINANCE_ENV=testnet
# BINANCE_ENV=demo

# Optional overrides
# BINANCE_API_BASE=https://fapi.binance.com
# BINANCE_WS_BASE=wss://fstream.binance.com/stream
# BINANCE_WS_USER_BASE=wss://fstream.binance.com/ws
# BINANCE_WS_API_BASE=wss://ws-fapi.binance.com/ws-fapi/v1

# MCP transport
# MCP_TRANSPORT=http   (default is stdio)
# PORT=3100